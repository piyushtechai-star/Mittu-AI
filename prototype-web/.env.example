# Copy to .env and fill in what you have. Everything is optional:
# without keys Mittu uses built-in readings + the browser's speech voice.

# --- Reading generation (Claude) ---
ANTHROPIC_API_KEY=
# MITTU_MODEL=claude-opus-5-5

# --- Voice (pick one). ElevenLabs gives word-level timing for karaoke subtitles. ---
ELEVENLABS_API_KEY=
# A Hindi/Hinglish-capable voice id from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_VOICE=hi-IN-SwaraNeural
