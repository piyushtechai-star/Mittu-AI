# Copy to .env (exactly that name) for local runs. On Cloud Run these come from env vars / Secret Manager.
# Never commit .env.

# Local test mode: no Google Cloud, no AI/TTS cost, no real payments, OTP is always 123456
STORE=memory
AI_PROVIDER=fake
TTS_PROVIDER=fake
BILLING_MODE=fake
OTP_MODE=console

# --- Production (Cloud Run mittuai-api) ---
# STORE=firestore
# GCP_PROJECT=colorjoy-app
# REGION=asia-south1
# FIRESTORE_DATABASE=mittuai
# MITTUAI_JWT_SECRET=<Secret Manager, 32+ random chars>
# OTP_MODE=sms
# SMS_UKEY=<Secret Manager>
# SMS_TEMPLATE_ID=<Mittu's DLT template id, from Ayush>
# AI_PROVIDER=vertex
# GEMINI_MODEL=gemini-3.8-flash
# TTS_PROVIDER=google
# TTS_VOICE=hi-IN-Neural2-A
# VOICE_BUCKET=mittuai-voice
# READINGS_PER_DAY=5
# BILLING_MODE=razorpay
# MITTUAI_RAZORPAY_KEY_ID / MITTUAI_RAZORPAY_KEY_SECRET / MITTUAI_RAZORPAY_WEBHOOK_SECRET=<Secret Manager, from Ayush>
# RAZORPAY_PLAN_ID=plan_...
# PLAN_NAME=mittuai_<price>
# TRIAL_PRICE_PAISE=100
# TRIAL_DAYS=3
# PRICE_PAISE=9900
# INVOICE_APP_CODE=MIT
